<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/padding_medium"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/padding_medium"
        android:paddingBottom="16dp">

        <ImageButton
        style="@style/BackButtonStyle"
            android:id="@+id/backSetting"
            android:src="@drawable/back_ic"/>

        <TextView
android:fontFamily="@font/ys_display_medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/app_settings"
            android:textSize="@dimen/text_size_22sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary"/>
    </LinearLayout>

    <Switch
        android:fontFamily="@font/ys_display_regular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/min_height"
        android:padding="@dimen/padding_rad"
        android:text="@string/night"
        android:textSize="@dimen/text_size_16sp" />

    <Button
        android:id="@+id/share_button"
        style="@style/SettingsButtonStyle"
        android:text="@string/app_share"
        app:icon="@drawable/give" />

    <Button
        android:id="@+id/support_button"
        style="@style/SettingsButtonStyle"
        android:text="@string/app_support"
        app:icon="@drawable/light_mode" />

    <Button
        android:id="@+id/agreement_button"
        style="@style/SettingsButtonStyle"
        android:text="@string/app_agreement"
        app:icon="@drawable/arrow" />
</LinearLayout>