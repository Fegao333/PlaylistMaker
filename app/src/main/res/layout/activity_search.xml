<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="24dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/ys_display_medium"
            android:text="@string/app_search"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/text_size_22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="@dimen/padding_small"
        android:paddingBottom="@dimen/padding_small">

        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/radius_search"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="@dimen/padding_small"
            android:drawableTint="?attr/icon_color"
            android:fontFamily="@font/ys_display_medium"
            android:hint="@string/app_search"
            android:paddingStart="@dimen/padding_12dp_primary"
            android:paddingEnd="40dp"
            android:textColorHint="?attr/icon_color"
            android:textSize="@dimen/text_size_16sp" />

        <ImageView
            android:id="@+id/clearIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="12dp"
            android:src="@drawable/delete_ic"
            android:visibility="invisible"
            app:tint="?attr/icon_color" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                style="@style/bar_linear">

                <ImageView
                    style="@style/bar_icon"
                    android:src="@drawable/ic_search" />

                <TextView
                    style="@style/bar_text_view"
                    android:text="@string/app_search" />
            </LinearLayout>

            <LinearLayout
                style="@style/bar_linear">

                <ImageView
                    style="@style/bar_icon"
                    android:src="@drawable/ic_media" />

                <TextView
                    style="@style/bar_text_view"
                    android:text="@string/app_media" />
            </LinearLayout>

            <LinearLayout
                style="@style/bar_linear">

                <ImageView
                    style="@style/bar_icon"
                    android:src="@drawable/ic_settings" />

                <TextView
                    style="@style/bar_text_view"
                    android:text="@string/app_settings" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>